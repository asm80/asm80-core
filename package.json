{
  "name": "@asm80/core",
  "version": "1.3.0",
  "description": "Core ASM80 compiler / assembler",
  "main": "asm.js",
  "type": "module",
  "files": [
    "asm.js",
    "beautify.js",
    "expression-parser.js",
    "libcode.js",
    "listing.js",
    "objcode.js",
    "parseLine.js",
    "parseLnk.js",
    "parser.js",
    "pass1.js",
    "pass2.js",
    "preprocessor.js",
    "semver-resolve.js",
    "cpu/",
    "utils/",
    "docs/*.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "c8 qunit && c8 report --reporter=html",
    "test:run": "c8 qunit",
    "test:report": "c8 report --reporter=html",
    "test:report:text": "c8 report --reporter=text",
    "test:fast": "qunit",
    "test:z180": "qunit test/asm-z180.js",
    "test:z80": "qunit test/asm-z80.js",
    "release": "npm version minor -m \"Release %s\" && git push --follow-tags",
    "release:patch": "npm version patch -m \"Release %s\" && git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asm80/asm80-core.git"
  },
  "keywords": [
    "ASM",
    "Assembler",
    "Z80",
    "6502"
  ],
  "author": "Martin Maly <maly@maly.cz>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/asm80/asm80-core/issues"
  },
  "homepage": "https://github.com/asm80/asm80-core#readme",
  "devDependencies": {
    "c8": "^12.0.0",
    "qunit": "^3.0.0"
  }
}
